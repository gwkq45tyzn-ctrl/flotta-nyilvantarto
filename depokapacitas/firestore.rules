        && request.resource.data.eventTime.matches('^' + request.resource.data.eventDate + 'T[0-9]{2}:[0-9]{2}:[0-9]{2}$')
        && request.resource.data.timeKnown is bool
        && validDriverCode(request.resource.data.daCode)
