rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function member() {
      return signedIn() && exists(userPath()) && get(userPath()).data.active == true;
    }
    function admin() { return member() && get(userPath()).data.role == 'admin'; }
    function editor() {
      return member() && get(userPath()).data.role in ['admin', 'editor'];
    }
    function declaredDriverCapacity(driverId) {
      return exists(/databases/$(database)/documents/driverCapacities/$(driverId))
        ? get(/databases/$(database)/documents/driverCapacities/$(driverId)).data.capacity
        : get(/databases/$(database)/documents/drivers/$(driverId)).data.capacity;
    }

    match /users/{uid} {
      // First admin must be created in the Firebase Console. No self-registration.
      allow get: if signedIn() && (request.auth.uid == uid || admin());
      allow list: if admin();
      allow create, update: if admin()
        && request.resource.data.keys().hasOnly(['name','role','active'])
        && request.resource.data.role in ['admin','editor','viewer']
        && request.resource.data.active is bool;
      allow delete: if admin() && uid != request.auth.uid;
    }

    match /drivers/{driverId} {
      allow read: if member();
      allow create, update: if admin()
        && request.resource.data.keys().hasOnly(['name','daCode','vendor','capacity','active'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.daCode is string
        && request.resource.data.daCode == driverId
        && request.resource.data.vendor is string
        && request.resource.data.active is bool
        && request.resource.data.capacity is int
        && request.resource.data.capacity >= 0
        && request.resource.data.capacity <= 10000;
      // A közös törzs rekordjait a két modul nem törölheti véletlenül.
      allow delete: if false;
    }
    match /vehicles/{vehicleId} {
      allow read: if member();
      allow create, update: if admin()
        && request.resource.data.keys().hasOnly(['plate','model','status'])
        && request.resource.data.plate is string
        && request.resource.data.plate == vehicleId
        && request.resource.data.model is string
        && request.resource.data.status in ['Elérhető','Szerviz','Leállított'];
      allow delete: if false;
    }
    match /driverCapacities/{driverId} {
      allow read: if member();
      allow create, update: if editor()
        && exists(/databases/$(database)/documents/drivers/$(driverId))
        && request.resource.data.keys().hasOnly(['capacity'])
        && request.resource.data.capacity is int
        && request.resource.data.capacity >= 0
        && request.resource.data.capacity <= 10000;
      allow delete: if editor();
    }
    match /demands/{id} {
      allow read: if member();
      allow create, update: if editor()
        && request.resource.data.keys().hasOnly(['date','district','newCount','retryCount'])
        && request.resource.data.newCount is int && request.resource.data.retryCount is int
        && request.resource.data.newCount >= 0 && request.resource.data.retryCount >= 0;
      allow delete: if editor();
    }
    match /results/{id} {
      allow read: if member();
      allow create, update: if editor()
        && request.resource.data.keys().hasOnly(['date','driverId','district','picked','success','failed'])
        && request.resource.data.picked is int
        && request.resource.data.success is int && request.resource.data.failed is int
        && request.resource.data.picked >= 0 && request.resource.data.success >= 0
        && request.resource.data.failed >= 0
        && request.resource.data.success + request.resource.data.failed <= request.resource.data.picked;
      allow delete: if editor();
    }
    match /bookings/{bookingId} {
      allow read: if member();
      allow create: if editor()
        && request.resource.data.keys().hasOnly(['date','vehicleId','driverId','district','status','capacity'])
        && request.resource.data.date is string
        && request.resource.data.vehicleId is string
        && request.resource.data.driverId is string
        && request.resource.data.district is string
        && bookingId == request.resource.data.date + '__' + request.resource.data.vehicleId
        && request.resource.data.status in ['planned','confirmed']
        && request.resource.data.capacity is int && request.resource.data.capacity >= 0 && request.resource.data.capacity <= 10000
        && request.resource.data.capacity == declaredDriverCapacity(request.resource.data.driverId)
        && get(/databases/$(database)/documents/vehicles/$(request.resource.data.vehicleId)).data.status == 'Elérhető'
        && get(/databases/$(database)/documents/drivers/$(request.resource.data.driverId)).data.active == true
        && exists(/databases/$(database)/documents/vehicles/$(request.resource.data.vehicleId))
        && exists(/databases/$(database)/documents/drivers/$(request.resource.data.driverId))
        && getAfter(/databases/$(database)/documents/driverClaims/$(request.resource.data.date + '__' + request.resource.data.driverId)).data.bookingId == bookingId;
      allow update: if false;
      allow delete: if editor()
        && !existsAfter(/databases/$(database)/documents/driverClaims/$(resource.data.date + '__' + resource.data.driverId));
    }
    match /driverClaims/{key} {
      allow read: if member();
      allow create: if editor()
        && request.resource.data.keys().hasOnly(['date','driverId','bookingId'])
        && request.resource.data.date is string
        && request.resource.data.driverId is string
        && request.resource.data.bookingId is string
        && key == request.resource.data.date + '__' + request.resource.data.driverId
        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.driverId == request.resource.data.driverId;
      allow update: if false;
      allow delete: if editor()
        && !existsAfter(/databases/$(database)/documents/bookings/$(resource.data.bookingId));
    }
    match /attendance/{id} {
      allow read: if member();
      // Attendance is imported by a trusted, IAM-authorized Google Apps Script.
      // Manual import from the logged-in web app is permitted for editors.
      allow create, update: if editor()
        && request.resource.data.keys().hasOnly(['eventTime','eventDate','timeKnown','daCode','driverName','vendor','type','status','photoFront','photoLeft','photoRight','photoBack','source'])
        && request.resource.data.type in ['Log In','Log Out'];
      allow delete: if admin();
    }
    match /sourceRows/{id} {
      allow read: if member();
      allow create, update: if editor()
        && request.resource.data.keys().hasOnly(['source','content','importedAt'])
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 18000;
      allow delete: if admin();
    }
    match /{path=**} { allow read, write: if false; }
  }
}